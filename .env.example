# ============================================================================
# Environment Variables Example
# Project: Smart Appointment & Consultation Booking Platform API
# ============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Supabase API Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-for-trusted-server-operations

# PostgreSQL Database Connection (Direct or Connection Pooler)
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
